# Template for local dev (.env.development) and production (.env.production) environments.
# Copy to .env.development, export APP_ENV=development and fill real values.
# Do NOT commit the filled file.
#
# In CI (build_and_deploy.yml) .env.production is assembled from
# Settings -> Secrets and variables -> Actions:
#   Variables tab -> ENV_APP    (app params)
#   Variables tab -> ENV_URLS   (service addresses)
#   Secrets tab   -> ENV_SECRET (credentials)

# ── App (ENV_APP) ──
PROMETHEUS_PORT=9464
# Cache freshness in hours; idustorage reads it lowercase, case matters on Linux
actuality=24
GEOSERVER_WORKSPACE=
# Cache dirs, relative to the app root (docker-compose.actions.yml mounts /app/__cache__)
COMMON_CACHE=__cache__
POPFRAME_TOWNS_CACHE=
POPFRAME_MODEL_CACHE=
GEOSERVER_CACHE_PATH=

# ── Service URLs (ENV_URLS) ──
URBAN_API=https://urban-api.example.com
TRANSPORTFRAME_API=
TOWNSNET_API=
SOCDEMO_API=
# GeoServer connection keys read by idugeoserverclient go here
# (copy the names from the current production env)

# ── Kafka (otteroad, KAFKA_ prefix) (ENV_URLS) ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=popframe-api
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Keycloak service account (ENV_URLS / ENV_SECRET) ──
# Used to write indicators into Urban DB with a service token
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
# secret -> ENV_SECRET
KEYCLOAK_CLIENT_SECRET=
